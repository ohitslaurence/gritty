{
  "name": "gritty-cli",
  "version": "0.2.0",
  "description": "AI-powered Git CLI tool using Claude",
  "type": "module",
  "bin": {
    "gritty": "./dist/gritty"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --bytecode --minify --sourcemap=none --outfile dist/gritty",
    "install:global": "mkdir -p ~/.local/bin && ln -sf $(pwd)/dist/gritty ~/.local/bin/gritty",
    "release": "bun run check && bun run build && echo '✓ gritty rebuilt'",
    "check": "bun run lint && bun run typecheck && bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "eval": "bun run evals/runners/eval-runner.ts",
    "eval:report": "bun run evals/runners/report-generator.ts",
    "precommit": "bun run check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4",
    "@ai-sdk/openai": "^4",
    "@effect/cli": "^0.77.1",
    "@effect/platform": "^0.97.2",
    "@effect/platform-bun": "^0.91.2",
    "ai": "^7",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^0.16.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT"
}
